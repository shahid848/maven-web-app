```groovy
pipeline {
    agent any

    tools {
        maven "Maven-3.9.16"
    }

    stages {

        stage('Clone') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/shahid848/maven-web-app.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

    }

    post {
        success {
            echo 'Build Successful'
        }
        failure {
            echo 'Build Failed'
        }
    }
}
```
